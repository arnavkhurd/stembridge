# Copy to .env.local; never commit credentials.
# Supabase Project Settings > API: URL and publishable key (not secret/service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Server-only Google AI Studio API key. Manual profile entry works without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
